[Unit]
Description=Run piframe script when WiFi is up
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/bin/bash -c "cd /home/jamie/PiFrame && git pull && source /home/jamie/.virtualenvs/pimoroni/bin/activate && python /home/jamie/PiFrame/Python/imagesd.py"
StandardOutput=journal
StandardError=journal
Restart=no
User=jamie
Environment=HOME=/home/jamie
WorkingDirectory=/home/jamie

[Install]
WantedBy=multi-user.target